AI_API_HOST=0.0.0.0
AI_API_PORT=5555
AI_API_RELOAD=true

SERVER_API_URL=http://localhost:5000/api/v1
INTERNAL_API_KEY=dev-internal-key-change-me
# Hosted mode fails closed unless every usage snapshot reaches the server.
# Community/local development must opt into unmetered self-hosted mode.
QUICKVOICE_BILLING_MODE=self_hosted
AI_BILLING_MAX_REPORTING_GAP_SECONDS=50
# Hosted deployments must set an absolute path backed by a persistent volume.
AI_BILLING_USAGE_QUEUE_DIR=/var/lib/quickvoice/billing-usage
AI_PARTICIPANT_WAIT_TIMEOUT_SECONDS=70
REDIS_URL=redis://localhost:6379
LIVE_TRANSCRIPT_TTL_SECONDS=3600
LIVE_TRANSCRIPT_QUEUE_SIZE=256

LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=dev-livekit-api-key
LIVEKIT_API_SECRET=dev-livekit-api-secret
LIVEKIT_AGENT_NAME=quickvoice-voice-agent
LIVEKIT_TURN_DOMAIN=turn.your-livekit-host

VOICE_CATALOG_PATH=
LLM_PROVIDER=bedrock_sdk
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_TIMEOUT_MS=30000
DEEPGRAM_API_KEY=
DEEPGRAM_DEFAULT_MODEL=nova-3
DEEPGRAM_DEFAULT_LANGUAGE=en
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_MODEL=eleven_flash_v2_5
ELEVENLABS_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL
SARVAM_API_KEY=
SARVAM_DEFAULT_STT_MODEL=saaras:v3
SARVAM_DEFAULT_TTS_MODEL=bulbul:v3
SARVAM_DEFAULT_LANGUAGE=en-IN
SARVAM_DEFAULT_SPEAKER=shubh

# ── Vector DB & Embedding Providers ─────────────────────────────────────────
# Options for VECTOR_STORE_PROVIDER: qdrant, pinecone (default: pinecone)
# Options for EMBEDDING_PROVIDER: google, fastembed, pinecone (default: pinecone)
# Provider changes are explicit so unrelated credentials cannot change an existing index.
VECTOR_STORE_PROVIDER=qdrant
EMBEDDING_PROVIDER=google

# Qdrant Vector Store (Dev: Local Docker or Free Cloud Cluster)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=quickvoice-kb

# Google GenAI Embeddings (Free tier key from Google AI Studio)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_EMBEDDING_DIMENSIONS=768

# FastEmbed (Local CPU, zero API keys needed - used when EMBEDDING_PROVIDER=fastembed)
FASTEMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# KB chunking uses the bundled all-MiniLM-L12-v2 tokenizer, independently of the
# embedding provider. Size includes overlap and excludes model special tokens.
KB_CHUNK_SIZE_TOKENS=220
KB_CHUNK_OVERLAP_TOKENS=32
# Match the embedding runtime: SentenceTransformers' upstream MiniLM L12 config
# defaults to 128. Set its model.max_seq_length=256 to use the 220-token budget,
# or set this limit to 128 (the chunker then caps content at 126 tokens).
KB_MAX_INPUT_TOKENS=256

# Pinecone Vector Store & Hosted Inference (Production option)
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
PINECONE_EMBEDDING_TRUNCATE=END

ENABLE_INTERRUPTS=true
SESSION_TOKEN_TTL_SECONDS=900
SESSION_ROOM_PREFIX=voice-

AWS_ACCESS_KEY_ID=dev-s3-access-key
AWS_SECRET_ACCESS_KEY=dev-s3-secret-access-key
# Required when using temporary STS credentials (e.g. from IAM roles or aws sts assume-role).
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_BUCKET_NAME=quickvoice-dev

# Legacy aliases still supported by apps/ai for existing local env files.
ACCESS_KEY=dev-s3-access-key
SECRET_ACCESS_KEY=dev-s3-secret-access-key
REGION=us-east-1
