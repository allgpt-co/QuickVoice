NODE_ENV=development
API_VERSION=v1
PORT=5000
SERVER_URL=http://localhost:5000
CONSOLE_URL=http://localhost:3000
WEB_URL=http://localhost:3001
DOCS_URL=http://localhost:3002
# Optional comma-separated extra browser origins allowed to call the API.
CORS_ORIGINS=

# Dev-only Docker Compose credentials. Do not reuse these outside local setup.
DATABASE_URL=postgresql://quickvoice:quickvoice@localhost:5432/quickvoice
REDIS_URL=redis://localhost:6379
LIVE_TRANSCRIPT_TTL_SECONDS=3600
WIDGET_ASSET_DIR=../widget/dist
WIDGET_SESSION_TTL_SECONDS=900
WIDGET_RATE_LIMIT_WINDOW_SECONDS=60
WIDGET_RATE_LIMIT_MAX_SESSIONS=10
WIDGET_MAX_CONCURRENT_SESSIONS_PER_WIDGET=5
WIDGET_ALLOW_LOCALHOST_ORIGINS=true
# Optional comma-separated readiness gates, for example: livekit,s3,stripe,twilio
READINESS_REQUIRED_INTEGRATIONS=

BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-32chars
INTERNAL_API_KEY=dev-internal-key-change-me
# Generate a dedicated 32-byte key, for example: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=replace-with-64-hex-characters

GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret

LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=dev-livekit-api-key
LIVEKIT_API_SECRET=dev-livekit-api-secret
LIVEKIT_AGENT_NAME=quickvoice-voice-agent
LIVEKIT_SIP_INBOUND_TRUNK_ID=dev-inbound-trunk
LIVEKIT_SIP_OUTBOUND_TRUNK_TWILIO_ID=dev-twilio-trunk
LIVEKIT_SIP_OUTBOUND_TRUNK_TELNYX_ID=dev-telnyx-trunk

TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=dev-twilio-auth-token
TWILIO_TRUNK_SID=dev-twilio-trunk-sid
TELNYX_API_KEY=dev-telnyx-api-key
TELNYX_CONNECTION_ID=dev-telnyx-connection-id
# Telnyx CDR reports omit currency; hosted reconciliation requires a USD account.
TELNYX_BILLING_CURRENCY=USD

AWS_ACCESS_KEY_ID=dev-s3-access-key
AWS_SECRET_ACCESS_KEY=dev-s3-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=quickvoice-dev

STRIPE_SECRET_KEY=sk_test_dev_placeholder
# Better Auth's legacy subscription lifecycle endpoint signing secret.
STRIPE_WEBHOOK_SECRET=whsec_dev_placeholder
# Dedicated signing secret for POST /api/v1/billing/stripe/webhook.
STRIPE_WALLET_WEBHOOK_SECRET=whsec_wallet_dev_placeholder
QUICKVOICE_BILLING_MODE=self_hosted
# Required in hosted mode. Only verified users created at or after this UTC
# timestamp receive the one-time $5 call-usage promotion in their first org.
BILLING_PROMO_START_AT=2026-08-01T00:00:00.000Z
# HMAC secret used to bind number quotes to org, provider, price, and expiry.
NUMBER_QUOTE_SIGNING_SECRET=dev-number-quote-secret-change-me
PROMOTIONAL_IDENTITY_SECRET=dev-promotion-identity-secret-change-me
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Required only when STRIPE_AUTOMATIC_TAX_ENABLED=true. Choose the Stripe Tax
# code matching your legal classification of prepaid voice/communications credit.
STRIPE_WALLET_TAX_CODE=
# Hosted cron/function request verification.
INNGEST_SIGNING_KEY=

# Global fallbacks. Per-agent transcript retention is configured in the console.
TRANSCRIPT_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=30
MCP_LOG_RETENTION_DAYS=30
FAILED_KB_RETENTION_DAYS=30
RETENTION_CLEANUP_BATCH_SIZE=25
KB_MAX_UPLOAD_BYTES=10485760
OUTBOUND_BATCH_MAX_UPLOAD_BYTES=5242880
OUTBOUND_BATCH_MAX_RECIPIENTS=10000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dev
SMTP_PASSWORD=dev
FROM_EMAIL=no-reply@localhost

SMITHERY_NAMESPACE=quickvoice
SMITHERY_API_KEY=dev-smithery-key
